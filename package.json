{
  "name": "cloudflare-speed-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run types && tsc --noEmit && node --check public/app.mjs && node --check public/measure.mjs",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:runtime": "node scripts/verify-dns-runtime.mjs",
    "test:e2e": "playwright test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "npm run check && npm test && npm run test:runtime && wrangler deploy",
    "verify:probes": "node scripts/verify-probes.mjs"
  },
  "dependencies": {
    "ipaddr.js": "^2.2.0",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "wrangler": "4.149.0"
  }
}
